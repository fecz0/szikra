{
  "name": "szikra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Szikra: demó B2B partnerportál ERPNext háttérrel (élő) vagy JSON snapshottal (deploy), CI/CD + DevSecOps + e2e folyamattal",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "erp:up": "docker compose -p szikra-erp -f erp/compose.yml up -d",
    "erp:down": "docker compose -p szikra-erp -f erp/compose.yml down",
    "erp:seed": "node erp/seed.ts",
    "erp:export": "node erp/export.ts",
    "erp:snapshot-offline": "node erp/snapshot-from-scenarios.ts",
    "erp:smoke": "node erp/live-smoke.ts",
    "dev:erp": "set -a; . erp/.env.local; set +a; nuxt dev"
  },
  "dependencies": {
    "nuxt": "^4.6.4",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@11.16.0"
}
