# Alapértelmezett háttér: JSON snapshot (server/data/snapshot.json), semmi mást nem kell beállítani.
NUXT_PUBLIC_DEMO_USERS=true
# NUXT_TEST_SEED=true            # e2e: a /__test/seed végpont él

# Élő ERPNext (pnpm erp:up && pnpm erp:seed; a kulcsokat az erp/.env.local tartalmazza):
# NUXT_BACKEND=erpnext
# NUXT_ERP_BASE_URL=http://127.0.0.1:8088
# NUXT_ERP_API_KEY=
# NUXT_ERP_API_SECRET=
# NUXT_SESSION_PASSWORD=         # >=32 karakter; nélküle élesben folyamatonként véletlen titok
